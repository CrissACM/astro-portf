---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import profileImage from '../assets/profile/profile.jpeg';
import { ACCENT_STORAGE_KEY } from '../lib/accent';

interface Props {
  title: string;
  description: string;
  imageAlt?: string;
}

const {
  title,
  description,
  imageAlt = 'Cristobal Colmenares, Full Stack Developer',
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = await getImage({
  src: profileImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 85,
});
const socialImageURL = new URL(socialImage.src, Astro.site);
const socialProfiles = [
  'https://github.com/CrissACM',
  'https://www.linkedin.com/in/crissacm',
  'https://x.com/CrissACM1',
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${canonicalURL.href}#person`,
      name: 'Cristobal Colmenares',
      url: canonicalURL.href,
      image: socialImageURL.href,
      jobTitle: 'Full Stack Developer',
      description,
      sameAs: socialProfiles,
      knowsAbout: [
        'Full-stack web development',
        'React',
        'TypeScript',
        'Node.js',
        'NestJS',
        'React Native',
        'Workflow automation',
        'Artificial intelligence',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalURL.origin}/#website`,
      url: canonicalURL.origin,
      name: 'Cristobal Colmenares — Portfolio',
      description,
      inLanguage: 'en',
      author: { '@id': `${canonicalURL.href}#person` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonicalURL.href}#profile`,
      url: canonicalURL.href,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${canonicalURL.origin}/#website` },
      mainEntity: { '@id': `${canonicalURL.href}#person` },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="dark scroll-smooth bg-[var(--page)] font-sans antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Cristobal Colmenares" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#050708" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Cristobal Colmenares — Portfolio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="profile:first_name" content="Cristobal" />
    <meta property="profile:last_name" content="Colmenares" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@CrissACM1" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="generator" content={Astro.generator} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline define:vars={{ accentStorageKey: ACCENT_STORAGE_KEY }}>
      (() => {
        const accent = localStorage.getItem(accentStorageKey);
        if (!accent || !/^#[0-9a-f]{6}$/i.test(accent)) return;
        const rgb = [
          Number.parseInt(accent.slice(1, 3), 16),
          Number.parseInt(accent.slice(3, 5), 16),
          Number.parseInt(accent.slice(5, 7), 16),
        ];
        const linear = rgb.map((value) => {
          const channel = value / 255;
          return channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4;
        });
        const luminance = 0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2];
        const root = document.documentElement;
        root.style.setProperty('--accent', accent);
        root.style.setProperty('--accent-rgb', rgb.join(', '));
        root.style.setProperty('--accent-contrast', luminance > 0.42 ? '#061114' : '#ffffff');
      })();
    </script>
  </head>
  <body class="m-0 min-h-dvh min-w-80 overflow-x-hidden bg-[radial-gradient(circle_at_10%_7%,rgba(var(--accent-rgb),0.11),transparent_26rem),radial-gradient(circle_at_92%_38%,rgba(var(--accent-rgb),0.07),transparent_32rem),var(--page)] text-[var(--text)] transition-[color,background-color] duration-200">
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 z-0 bg-[linear-gradient(var(--grid)_1px,transparent_1px),linear-gradient(90deg,var(--grid)_1px,transparent_1px)] bg-[length:42px_42px] max-[760px]:bg-[length:28px_28px]"
    ></div>
    <slot />
  </body>
</html>
